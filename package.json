{
  "name": "flutter-dev-tools",
  "displayName": "FlutterDevTools",
  "description": "flutter开发工具集",
  "publisher": "wanggaowan",
  "version": "1.0.4",
  "engines": {
    "vscode": "^1.99.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false
    },
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "categories": [
    "Other"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanggaowan/flutter-dev-tools"
  },
  "keywords": [
    "dart",
    "flutter"
  ],
  "icon": "media/flutter.png",
  "activationEvents": [
    "workspaceContains:pubspec.yaml",
    "workspaceContains:*/pubspec.yaml",
    "workspaceContains:*/*/pubspec.yaml",
    "workspaceContains:*.dart",
    "workspaceContains:*/*.dart",
    "workspaceContains:*/*/*.dart"
  ],
  "extensionDependencies": [
    "Dart-Code.dart-code"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flutterDevTools.file.location",
        "title": "File Location",
        "icon": "media/location.svg"
      },
      {
        "command": "flutterDevTools.json2dart",
        "title": "json to dart"
      },
      {
        "command": "flutterDevTools.genConstructor",
        "title": "创建构造函数"
      },
      {
        "command": "flutterDevTools.getter",
        "title": "Getter"
      },
      {
        "command": "flutterDevTools.setter",
        "title": "Setter"
      },
      {
        "command": "flutterDevTools.getterAndSetter",
        "title": "Getter And Setter"
      },
      {
        "command": "flutterDevTools.genSerialization",
        "title": "创建序列化方法"
      },
      {
        "command": "flutterDevTools.genGFile",
        "title": "全局生成.g.dart文件"
      },
      {
        "command": "flutterDevTools.genGFileSingle",
        "title": "生成.g.dart文件"
      },
      {
        "command": "flutterDevTools.showDeps",
        "title": "Show Dependencies"
      },
      {
        "command": "flutterDevTools.translateArb",
        "title": "根据模版arb翻译"
      },
      {
        "command": "flutterDevTools.extractL10n",
        "title": "提取多语言"
      },
      {
        "command": "flutterDevTools.extractL10nAndTranslate",
        "title": "提取多语言并翻译"
      },
      {
        "command": "flutterDevTools.deleteArbKeys",
        "title": "在所有arb文件中删除此项"
      },
      {
        "command": "flutterDevTools.translateSelectionToArb",
        "title": "翻译此项到其它arb文件"
      },
      {
        "command": "flutterDevTools.importAndroidImages",
        "title": "导入 Android 图片资源"
      }
    ],
    "submenus": [
      {
        "id": "flutterDevTools.editorContext",
        "label": "Flutter"
      },
      {
        "id": "flutterDevTools.explorerContext",
        "label": "Flutter"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "flutterDevTools.file.location",
          "when": "false"
        },
        {
          "command": "flutterDevTools.json2dart",
          "when": "false"
        },
        {
          "command": "flutterDevTools.genConstructor",
          "when": "false"
        },
        {
          "command": "flutterDevTools.genSerialization",
          "when": "false"
        },
        {
          "command": "flutterDevTools.genGFile",
          "when": "flutterDevTools.isFlutterProject"
        },
        {
          "command": "flutterDevTools.genGFileSingle",
          "when": "false"
        },
        {
          "command": "flutterDevTools.showDeps",
          "when": "flutterDevTools.isFlutterProject"
        },
        {
          "command": "flutterDevTools.translateArb",
          "when": "false"
        },
        {
          "command": "flutterDevTools.getter",
          "when": "false"
        },
        {
          "command": "flutterDevTools.setter",
          "when": "false"
        },
        {
          "command": "flutterDevTools.getterAndSetter",
          "when": "false"
        },
        {
          "command": "flutterDevTools.extractL10n",
          "when": "false"
        },
        {
          "command": "flutterDevTools.extractL10nAndTranslate",
          "when": "false"
        },
        {
          "command": "flutterDevTools.deleteArbKeys",
          "when": "false"
        },
        {
          "command": "flutterDevTools.translateSelectionToArb",
          "when": "false"
        },
        {
          "command": "flutterDevTools.importAndroidImages",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "submenu": "flutterDevTools.explorerContext",
          "when": "flutterDevTools.isFlutterProject",
          "group": "navigation"
        }
      ],
      "flutterDevTools.explorerContext": [
        {
          "command": "flutterDevTools.translateArb",
          "when": "resourceExtname == .arb",
          "group": "a"
        },
        {
          "command": "flutterDevTools.importAndroidImages",
          "when": "explorerResourceIsFolder",
          "group": "a@1"
        },
        {
          "command": "flutter.task.genl10n",
          "when": "dart-code:anyProjectLoaded",
          "group": "z_commands"
        },
        {
          "command": "pub.get",
          "when": "dart-code:anyProjectLoaded",
          "group": "z_commands@1"
        },
        {
          "command": "pub.get.all",
          "when": "dart-code:anyProjectLoaded",
          "group": "z_commands@2"
        },
        {
          "command": "flutterDevTools.showDeps",
          "when": "dart-code:anyProjectLoaded",
          "group": "z_commands@3"
        }
      ],
      "view/title": [
        {
          "command": "flutterDevTools.file.location",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "submenu": "flutterDevTools.editorContext",
          "when": "flutterDevTools.isFlutterProject",
          "group": "navigation"
        }
      ],
      "flutterDevTools.editorContext": [
        {
          "command": "flutterDevTools.extractL10n",
          "when": "resourceLangId == dart",
          "group": "a"
        },
        {
          "command": "flutterDevTools.extractL10nAndTranslate",
          "when": "resourceLangId == dart",
          "group": "a@1"
        },
        {
          "command": "flutterDevTools.deleteArbKeys",
          "when": "resourceExtname == .arb",
          "group": "a@2"
        },
        {
          "command": "flutterDevTools.translateSelectionToArb",
          "when": "resourceExtname == .arb",
          "group": "a@3"
        },
        {
          "command": "flutterDevTools.genConstructor",
          "when": "resourceLangId == dart",
          "group": "gen"
        },
        {
          "command": "flutterDevTools.getter",
          "when": "resourceLangId == dart",
          "group": "gen@1"
        },
        {
          "command": "flutterDevTools.setter",
          "when": "resourceLangId == dart",
          "group": "gen@2"
        },
        {
          "command": "flutterDevTools.getterAndSetter",
          "when": "resourceLangId == dart",
          "group": "gen@3"
        },
        {
          "command": "flutterDevTools.json2dart",
          "when": "resourceLangId == dart",
          "group": "json2dart"
        },
        {
          "command": "flutterDevTools.genSerialization",
          "when": "resourceLangId == dart",
          "group": "json2dart@1"
        },
        {
          "command": "flutterDevTools.genGFileSingle",
          "when": "resourceLangId == dart",
          "group": "json2dart@2"
        },
        {
          "command": "flutterDevTools.genGFile",
          "when": "flutterDevTools.isFlutterProject",
          "group": "json2dart@3"
        },
        {
          "command": "flutter.task.genl10n",
          "when": "dart-code:anyProjectLoaded",
          "group": "z_commands"
        },
        {
          "command": "pub.get",
          "when": "dart-code:anyProjectLoaded",
          "group": "z_commands@1"
        },
        {
          "command": "pub.get.all",
          "when": "dart-code:anyProjectLoaded",
          "group": "z_commands@2"
        },
        {
          "command": "flutterDevTools.showDeps",
          "when": "dart-code:anyProjectLoaded",
          "group": "z_commands@3"
        }
      ]
    },
    "views": {
      "resource-manger": [
        {
          "id": "imagePreviewView",
          "type": "webview",
          "name": "Image",
          "icon": "media/resource.svg",
          "when": "flutterDevTools.isFlutterProject"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "resource-manger",
          "title": "Resource Manager",
          "icon": "media/Resources.svg"
        }
      ]
    },
    "configuration": [
      {
        "title": "资源配置",
        "properties": {
          "flutterDevTools.imageSrcPath": {
            "type": "string",
            "default": "assets/images",
            "description": "存放图片资源的目录,此目录为基于当前项目根目录的相对目录",
            "scope": "window"
          },
          "flutterDevTools.imagesFilePath": {
            "type": "string",
            "default": "lib/resources/images.dart",
            "description": "生成图片引用类文件所在路径。此目录为基于当前项目根目录的相对目录",
            "scope": "window"
          },
          "flutterDevTools.imagesClassName": {
            "type": "string",
            "default": "Images",
            "description": "生成图片引用类文件中class的名称，只要图片引用都是基于此类名称",
            "scope": "window"
          }
        }
      },
      {
        "title": "class生成配置",
        "properties": {
          "flutterDevTools.converters": {
            "type": "string",
            "default": "",
            "description": "生成序列化方法时，@JsonSerializable(converters: convertersName)中converters名称",
            "scope": "window"
          }
        }
      },
      {
        "title": "json to dart",
        "properties": {
          "flutterDevTools.classSuffix": {
            "type": "string",
            "default": "Entity",
            "description": "生成的类后缀",
            "scope": "window"
          },
          "flutterDevTools.genDoc": {
            "type": "boolean",
            "default": true,
            "description": "json值是否作为备注",
            "scope": "window"
          },
          "flutterDevTools.genConstructor": {
            "type": "boolean",
            "default": true,
            "description": "是否生成构造函数",
            "scope": "window"
          },
          "flutterDevTools.genSerialization": {
            "type": "boolean",
            "default": true,
            "description": "是否生成序列化方法",
            "scope": "window"
          }
        }
      },
      {
        "title": "翻译",
        "properties": {
          "flutterDevTools.aliAk": {
            "type": "string",
            "default": "",
            "description": "阿里翻译AK",
            "scope": "window"
          },
          "flutterDevTools.aliSk": {
            "type": "string",
            "default": "",
            "description": "阿里翻译SK",
            "scope": "window"
          },
          "flutterDevTools.showRenameDialog": {
            "type": "boolean",
            "default": true,
            "description": "提取多语言时，是否展示重命名弹窗",
            "scope": "window"
          },
          "flutterDevTools.showL10nText": {
            "type": "boolean",
            "default": true,
            "description": "是否在代码中展示多语言真实文本",
            "scope": "window"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "@alicloud/alimt20181012": "^1.0.4",
    "adm-zip": "^0.6.1",
    "vscode-uri": "^3.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.1",
    "eslint": "^9.23.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.2"
  }
}
